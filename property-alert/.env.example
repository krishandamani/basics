# Gmail SMTP credentials
EMAIL_FROM=you@gmail.com
EMAIL_TO=you@gmail.com
# Generate at: Google Account → Security → 2-Step Verification → App Passwords
EMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Google Maps API key (free tier covers ~40k requests/month)
# Get one at: console.cloud.google.com → Enable "Distance Matrix API"
GOOGLE_MAPS_API_KEY=

# EPC Register API (free — register at epc.opendatacommunities.org)
EPC_API_KEY=
