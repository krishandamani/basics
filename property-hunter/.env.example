# Copy this file to .env and fill in your values.
# The setup wizard (python setup_wizard.py) will do this for you automatically.

# Gmail address — used to SEND and RECEIVE property alerts
GMAIL_ADDRESS=t.guiner2@googlemail.com

# Gmail App Password (NOT your regular Gmail password)
# Create one at: https://myaccount.google.com/apppasswords
# Enable 2-Step Verification first, then generate an App Password for "Mail"
GMAIL_APP_PASSWORD=your-16-char-app-password
