#!/usr/bin/env python3
"""propcomps — pull EPC certificates and Land Registry sales for given postcodes.

Usage:
    propcomps "EN6 4DZ" "EN6 4DY" "EN6 4EA"

Writes two CSVs into the CURRENT directory:
    epc_<postcodes>.csv    every EPC certificate for those postcodes,
                           NOT deduplicated to the latest — the duplicates are
                           the point (they reveal extensions and assessor
                           disagreement), one row per certificate
    sales_<postcodes>.csv  category-A sales only; category B is repossessions
                           and non-arm's-length transfers and must not be used
                           as a comparable

Postcodes are matched space- and case-insensitively, so "en64dz" works.
"""
import os
import sys

import duckdb

DB = os.path.expanduser("~/prop/prop.duckdb")


def norm(pc):
    return pc.replace(" ", "").strip().upper()


def slug(postcodes):
    s = "_".join(norm(p) for p in postcodes)
    return s if len(s) <= 60 else s[:57] + "etc"


def table_exists(con, name):
    return con.execute(
        "SELECT count(*) FROM information_schema.tables WHERE table_name = ?", [name]
    ).fetchone()[0] > 0


def main():
    if len(sys.argv) < 2:
        sys.exit(__doc__)
    postcodes = sys.argv[1:]
    keys = [norm(p) for p in postcodes]

    if not os.path.exists(DB):
        sys.exit(f"ERROR: no store at {DB}. Run build_store.py first.")
    con = duckdb.connect(DB, read_only=True)
    tag = slug(postcodes)
    wrote = []

    # ---- EPC: every certificate, no dedupe ------------------------------
    if table_exists(con, "epc"):
        out = os.path.abspath(f"epc_{tag}.csv")
        con.execute(f"""
            COPY (
                SELECT *,
                       count(*)      OVER (PARTITION BY upper(trim(address1)),
                                                        replace(upper(postcode),' ','')) AS certs_for_address,
                       row_number()  OVER (PARTITION BY upper(trim(address1)),
                                                        replace(upper(postcode),' ','')
                                           ORDER BY inspection_date) AS cert_seq
                FROM epc
                WHERE replace(upper(postcode), ' ', '') IN ({','.join('?' * len(keys))})
                ORDER BY postcode, address1, inspection_date
            ) TO '{out}' (HEADER, DELIMITER ',')
        """, keys)
        n = con.execute(
            f"SELECT count(*) FROM epc WHERE replace(upper(postcode),' ','') "
            f"IN ({','.join('?' * len(keys))})", keys).fetchone()[0]
        print(f"  {n:>6,} EPC certificates  -> {out}")
        wrote.append(out)
    else:
        print("  WARNING: no 'epc' table in the store — EPC CSV not written.")

    # ---- Sales: category A only ----------------------------------------
    if table_exists(con, "sales"):
        out = os.path.abspath(f"sales_{tag}.csv")
        con.execute(f"""
            COPY (
                SELECT price, date_of_transfer, postcode, paon, saon, street,
                       locality, town_city, district, county,
                       property_type, old_new, duration,
                       ppd_category_type, transaction_id
                FROM sales
                WHERE replace(upper(postcode), ' ', '') IN ({','.join('?' * len(keys))})
                  AND ppd_category_type = 'A'
                  AND record_status <> 'D'
                ORDER BY postcode, date_of_transfer
            ) TO '{out}' (HEADER, DELIMITER ',')
        """, keys)
        n_a, n_b = con.execute(
            f"""SELECT count(*) FILTER (WHERE ppd_category_type='A'),
                       count(*) FILTER (WHERE ppd_category_type='B')
                FROM sales WHERE replace(upper(postcode),' ','')
                IN ({','.join('?' * len(keys))}) AND record_status <> 'D'""",
            keys).fetchone()
        print(f"  {n_a:>6,} category-A sales  -> {out}")
        if n_b:
            print(f"  {n_b:>6,} category-B sales excluded (repossession / non-arm's-length)")
        wrote.append(out)
    else:
        print("  WARNING: no 'sales' table in the store — sales CSV not written.")

    con.close()
    if not wrote:
        sys.exit(1)


if __name__ == "__main__":
    main()
